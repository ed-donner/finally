{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "playwright@claude-plugins-official": true
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/doc-review --doc-path=planning/REVIEW.md"
          },
          {
            "type": "command",
            "command": "/doc-review --doc-path=README.md"
          }
        ]
      }
    ]
  }
}
