# Serve the UI with built-in mock data (no backend needed). You can also open the app with ?mock=1.
NEXT_PUBLIC_USE_MOCK=false

# Only needed if the API is on a different origin than the UI. Leave empty for same-origin (/api/*).
NEXT_PUBLIC_API_BASE=

# Dev proxy target for `next dev` (server-side only).
BACKEND_URL=http://localhost:8000
